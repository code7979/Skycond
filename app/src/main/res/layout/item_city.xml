<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_city_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/large"
    android:layout_marginEnd="@dimen/large"
    android:layout_marginBottom="@dimen/large"
    android:background="@drawable/weather_screen_card_bg"
    android:orientation="vertical"
    android:padding="@dimen/medium">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/item_btn_location"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="false"
        app:icon="@drawable/ic_location"
        app:iconSize="@dimen/very_large"
        app:iconTint="?attr/colorControlNormal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/item_tv_city_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Patna"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/item_tv_city_state"
        app:layout_constraintEnd_toStartOf="@+id/item_btn_add_city"
        app:layout_constraintStart_toEndOf="@+id/item_btn_location"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />


    <TextView
        android:id="@+id/item_tv_city_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bihar, IN"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_btn_add_city"
        app:layout_constraintStart_toEndOf="@+id/item_btn_location"
        app:layout_constraintTop_toBottomOf="@+id/item_tv_city_name" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/item_btn_add_city"
        style="?attr/materialIconButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="false"
        app:icon="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>