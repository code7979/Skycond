<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadingEdgeLength="?attr/actionBarSize"
    android:requiresFadingEdge="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/large"
        android:paddingVertical="@dimen/medium">

        <LinearLayout
            android:id="@+id/pb_weather_updating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ProgressBar
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminateDrawable="@drawable/bg_progress"
                android:indeterminateOnly="true"
                android:indeterminateTint="@color/color_text_secondary"
                android:progress="0" />

            <View
                android:layout_width="@dimen/nano"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refreshing"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/small_text" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/medium" />

        <TextView
            android:id="@+id/weather_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_sky"
            android:textAlignment="center"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="@dimen/large_text"
            app:drawableTopCompat="@drawable/bg_realistic_sun" />

        <include
            android:id="@+id/temperature_card"
            layout="@layout/temperature_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <include
            android:id="@+id/detail_divider"
            layout="@layout/detail_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/detail_card_1"
            layout="@layout/detail_card_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            android:id="@+id/detail_card_2"
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

        <include
            layout="@layout/detail_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/nano" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

